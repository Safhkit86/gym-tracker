# Copia questo file in .env.production e personalizza per lo stack di
# produzione (docker-compose.prod.yml). .env.production non va mai
# committato (vedi .gitignore) e non va MAI confuso con .env (quello dello
# stack di sviluppo/test): sono due file distinti apposta, cosi' i due
# ambienti non si mischiano mai.
#
# Ogni valore CAMBIAMI/CONFIGURA_SMTP_REALE qui sotto e' un segnaposto:
# vanno sostituiti con segreti veri prima di usare questo stack per
# davvero. Per generarne uno forte:
#   openssl rand -base64 32
# oppure, senza openssl:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ATTENZIONE per POSTGRES_PASSWORD e RABBITMQ_PASSWORD: docker-compose.prod.yml
# incolla il valore direttamente dentro un URL di connessione (es.
# postgres://user:PASSWORD@postgres:5432/db). L'output di `openssl rand
# -base64` puo' contenere '+', '/', '=' non validi in un URL senza
# percent-encoding, e ogni servizio va in crash-loop all'avvio con
# "Configurazione non valida: DATABASE_URL: Invalid url". Per queste due usa
# SEMPRE il comando esadecimale (node -e ... 'hex'), mai --base64. Per
# JWT_SECRET, che non finisce mai dentro un URL, entrambi i comandi vanno bene.

# --- Postgres ---
POSTGRES_USER=gymtracker
# Solo esadecimale, vedi ATTENZIONE qui sopra (mai `openssl rand -base64`).
POSTGRES_PASSWORD=CAMBIAMI_esadecimale
POSTGRES_DB=gymtracker
# Porta pubblicata sull'host: diversa da quella di dev (5432) apposta, cosi'
# i due stack possono girare insieme sulla stessa macchina senza conflitti.
POSTGRES_PORT=6432

# Solo per script lanciati SULL'HOST (es. le migrazioni, vedi README.md
# "Produzione (locale)"): NON viene letto da docker-compose.prod.yml, che
# costruisce la propria DATABASE_URL con l'hostname interno "postgres" a
# partire dalle POSTGRES_* qui sopra.
DATABASE_URL=postgres://gymtracker:CAMBIAMI_esadecimale@localhost:6432/gymtracker

# --- Redis ---
REDIS_PORT=7379

# --- RabbitMQ ---
RABBITMQ_USER=gymtracker
# Solo esadecimale, vedi ATTENZIONE qui sopra (mai `openssl rand -base64`).
RABBITMQ_PASSWORD=CAMBIAMI_esadecimale
RABBITMQ_PORT=6672
RABBITMQ_MANAGEMENT_PORT=16672

# --- Segreto per firmare/verificare i JWT: OBBLIGATORIO generarne uno vero,
# mai riusare il valore di dev ne' lasciare questo segnaposto. ---
JWT_SECRET=CAMBIAMI_con_un_secret_lungo_e_casuale

# --- Email (reset password, avviso dead-letter) ---
# TODO esplicito: nessun Mailpit in produzione (a differenza di dev), e
# finche' queste non sono configurate con un relay SMTP reale, le funzioni
# email falliranno in modo comprensibile (connessione rifiutata/host
# sconosciuto) — non silenziosamente, e senza intaccare il resto dell'app.
SMTP_HOST=CONFIGURA_SMTP_REALE
SMTP_PORT=587
SMTP_FROM=no-reply@gym-tracker.local
OPS_ALERT_EMAIL=ops@gym-tracker.local

# URL della webapp usato per costruire il link di reset password nell'email
# (link per il browser dell'utente): deve puntare alla porta pubblicata da
# WEB_PORT qui sotto.
WEB_APP_URL=http://localhost:8080

# --- Porte pubblicate sull'host per ogni servizio (schema "dev + 1000") ---
API_GATEWAY_PORT=5000
ACCOUNT_SERVICE_PORT=5001
WORKOUT_SERVICE_PORT=5002
PROGRESS_SERVICE_PORT=5003
NOTIFY_SERVICE_PORT=5004
HISTORY_SERVICE_PORT=5005

# --- Webapp (nginx, build statica) ---
WEB_PORT=8080
